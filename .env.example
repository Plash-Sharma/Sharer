# Database
DATABASE_URL="postgresql://drivelite:drivelite@localhost:5433/drivelite?schema=public"

# Auth
NEXTAUTH_SECRET="drivelite-dev-secret-min-32-characters-for-jwt"
NEXTAUTH_URL="http://localhost:3000"

# MinIO / S3 Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=drivelite-files
S3_ACCESS_KEY=drivelite-app
S3_SECRET_KEY=drivelitesecret123
S3_FORCE_PATH_STYLE=true

# Upload and Presign Limits
MAX_UPLOAD_BYTES=104857600
PRESIGN_PUT_TTL_SECONDS=300
PRESIGN_GET_TTL_SECONDS=60
